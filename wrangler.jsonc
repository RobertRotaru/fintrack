// Cloudflare Worker for the web app: README → Deploying. "name" must match the Worker's name in the dashboard.
{
  "name": "fintrack",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    // Client-side routes (/goals, /reports, …) load the app instead of a 404.
    "not_found_handling": "single-page-application",
    // Only /api goes through the Worker; everything else is served straight from the files.
    "run_worker_first": ["/api/*"]
  },
  // API_ORIGIN is set in the dashboard (Settings → Variables and Secrets); keep it on every deploy.
  "keep_vars": true
}
