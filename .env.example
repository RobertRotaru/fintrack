# Copy to .env (repo root). Read by `npm run dev` / `./gradlew bootRun` and by docker compose.

# PostgreSQL (defaults match docker compose's database)
DB_URL=jdbc:postgresql://localhost:5432/fintrack
DB_USER=fintrack
DB_PASSWORD=fintrack

# Signs session tokens — at least 32 characters; required in production.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Needed for the AI investment coach (Invest page)
ANTHROPIC_API_KEY=
# Optional: override the model used by the coach
# ANTHROPIC_MODEL=claude-opus-5-5

# Profile photos: kept in Cloudflare R2, never in the database (README → Profile photos).
# Leave STORAGE_DRIVER unset to use "local", a stand-in bucket on disk under STORAGE_DIR.
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=fintrack-photos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://photos.example.com
# STORAGE_DIR=.data/uploads

# Optional
# PORT=4000
# CORS_ORIGIN=https://app.example.com
# FX_ENABLED=true
